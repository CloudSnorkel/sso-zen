{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go Debug",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "cwd": "${workspaceFolder}",
            "env": {
                "SSO_ZEN_DEBUG": "1"
            },
            "args": [],
            "showLog": true,
        },
        {
            "name": "Go Run",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/main.go",
            "cwd": "${workspaceFolder}",
            "env": {
                "SSO_ZEN_DEBUG": "1"
            },
            "args": [""],
        }
    ]
}